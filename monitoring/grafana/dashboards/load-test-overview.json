{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "load-test-overview",
  "title": "Pruebas de Carga - Vista General",
  "tags": ["k6", "load-test", "juegos-api"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "K6 - Metricas de cliente",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Latencia HTTP por endpoint (p95)",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "max by (endpoint) (k6_http_req_duration_p95{endpoint!=\"\"})",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput por endpoint (requests/seg)",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(k6_http_reqs_total{endpoint!=\"\"}[30s]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VUs activos",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "thresholds" } }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "max(k6_vus)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "(sum(rate(k6_http_reqs_total{expected_response=\"false\"}[1m])) or vector(0)) / sum(rate(k6_http_reqs_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia global - cuantiles agregados",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        { "expr": "avg(avg_over_time(k6_http_req_duration_avg[1m]))", "legendFormat": "avg", "refId": "A" },
        { "expr": "max(max_over_time(k6_http_req_duration_p50[1m]))", "legendFormat": "p50", "refId": "B" },
        { "expr": "max(max_over_time(k6_http_req_duration_p95[1m]))", "legendFormat": "p95", "refId": "C" },
        { "expr": "max(max_over_time(k6_http_req_duration_p99[1m]))", "legendFormat": "p99", "refId": "D" },
        { "expr": "max(max_over_time(k6_http_req_duration_max[1m]))", "legendFormat": "max", "refId": "E" }
      ]
    },
    {
      "type": "stat",
      "title": "Total requests",
      "id": 10,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(k6_http_reqs_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Iteraciones completas",
      "id": 11,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(k6_iterations_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "PostgreSQL",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Conexiones activas vs pool",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{datname=\"juegos-carga\"}) by (state)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transacciones (commits + rollbacks/s)",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[1m])", "legendFormat": "commits - {{datname}}", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[1m])", "legendFormat": "rollbacks - {{datname}}", "refId": "B" }
      ]
    },
    {
      "type": "row",
      "title": "Contenedores (cAdvisor)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU por contenedor (cores)",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"juegos-.*\"}[1m])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memoria por contenedor (bytes)",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"juegos-.*\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }
  ]
}